// ---- AArch64 condition codes ----------------------------------------------
global AARCH64_EQ: i32 = 0;
global AARCH64_NE: i32 = 1;
global AARCH64_CS: i32 = 2;
global AARCH64_CC: i32 = 3;
global AARCH64_MI: i32 = 4;
