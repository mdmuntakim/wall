// stage1/tools/obasm.wa
// ---------------------------------------------------------------------------
// obasm - the Wall object assembler, written in Wall itself.
//
// obasm turns *any* textual assembly file (.s), including the LLVM textual IR
// emitted by `wall`, into a native relocatable object file (.o).
//
// Usage:
//   obasm <input.s> [-o <output.o>] [--target=<triple>]
//                   [--direct] [--keep-bc] [-v] [-h] [-v]
//
// Two back ends are provided:
//
//   * pipeline mode (default): .s -> LLVM bitcode -> native object.  The two
//     stages are performed by the Wall runtime hooks rt_llvm_as() and
//     rt_cc_object(), which bootstrap to `llvm-as` and the target C compiler.
//
//   * direct mode (--direct): the assember parses the textual assembly and
//     writes an ELF relocatable object itself through rt_elf_* primitives.
//     This path is what makes obasm a true self-hosted assembler: no external
//     llvm-as or clang is required once the runtime hooks are implemented.
//
// Wall -> C mapping
// -----------------
// This file is the Wall transcription of src/assembler/obasm.c.  The C
// functions run_cmd() and assemble() become rt_exec() and assemble(); the C
// stdio calls become the rt_file_* hooks.
// ---------------------------------------------------------------------------

// ===========================================================================
// Wall runtime hooks
// ===========================================================================
fn rt_exit(code: i32) -> i32 { return 0; }
fn rt_stderr(s: string) -> i32 { return 0; }
fn rt_stdout(s: string) -> i32 { return 0; }
fn rt_exec(argv: string) -> i32 { return 0; }
fn rt_file_exists(path: string) -> bool { return false; }
fn rt_file_read(path: string) -> string { return ""; }
fn rt_file_write(path: string, data: string) -> i32 { return 0; }
fn rt_file_size(path: string) -> i32 { return 0; }
fn rt_temp_name(prefix: string) -> string { return ""; }
fn rt_basename(path: string) -> string { return ""; }
fn rt_dirname(path: string) -> string { return ""; }
fn rt_extension(path: string) -> string { return ""; }
fn rt_strip_extension(path: string) -> string { return ""; }
fn rt_join_path(a: string, b: string) -> string { return ""; }

// LLVM pipeline hooks
fn rt_llvm_as(input: string, bitcode_out: string) -> i32 { return 0; }
fn rt_cc_object(bitcode: string, triple: string, out: string) -> i32 { return 0; }

// Direct ELF writer hooks (pure Wall object generation)
fn rt_elf_begin(out: string, triple: string) -> i32 { return 0; }
fn rt_elf_add_text(asm: string) -> i32 { return 0; }
fn rt_elf_add_symbol(name: string, value: i32, binding: i32, kind: i32) -> i32 { return 0; }
fn rt_elf_add_reloc(sym: string, offset: i32, kind: i32, addend: i32) -> i32 { return 0; }
fn rt_elf_finish() -> i32 { return 0; }

// ===========================================================================
// Options
// ===========================================================================
global g_in: string = "";
global g_out: string = "";
global g_triple: string = "";
global g_direct: i32 = 0;
global g_keep_bc: i32 = 0;
global g_verbose: i32 = 0;
global g_ninputs: i32 = 0;

fn print_help() -> i32 {
  rt_stdout("wall version 1.0.0\n");
  rt_stdout("Usage: obasm <input.s> [-o <output.o>] [--target=<triple>]\n");
  rt_stdout("\n");
  rt_stdout("Assembles any textual assembly (.s) into a native object (.o).\n");
  rt_stdout("\n");
  rt_stdout("Options:\n");
  rt_stdout("  -o <filename>        Set output filename (default: <input>.o)\n");
  rt_stdout("  --target=<triple>    Set the target triple (default: llvm default)\n");
  rt_stdout("  --direct             Assemble to ELF directly (no external tools)\n");
  rt_stdout("  --keep-bc            Keep the intermediate bitcode file\n");
  rt_stdout("  -v, --verbose        Print each pipeline step\n");
  rt_stdout("  -V, --version        Print version information and exit\n");
  rt_stdout("  -h, --help           Print this help message and exit\n");
  return 0;
}

fn print_version() -> i32 {
  rt_stdout("wall version 1.0.0\n");
  return 0;
}

// ===========================================================================
// Argument parsing (mirrors the argv loop in obasm.c)
// ===========================================================================
fn parse_args(argc: i32, argv: string) -> i32 {
  let i: i32 = 1;
  while (i < argc) {
    let a: string = rt_arg(argv, i);
    if (a == "-h" || a == "--help") {
      print_help();
      rt_exit(0);
    } else if (a == "-V" || a == "--version") {
      print_version();
      rt_exit(0);
    } else if (a == "-o") {
      if (i + 1 < argc) {
        i = i + 1;
        g_out = rt_arg(argv, i);
      } else {
        rt_stderr("obasm: error: -o requires a filename\n");
        rt_exit(1);
      }
    } else if (a == "--direct") {
      g_direct = 1;
    } else if (a == "--keep-bc") {
      g_keep_bc = 1;
    } else if (a == "-v" || a == "--verbose") {
      g_verbose = 1;
    } else if (rt_starts_with(a, "--target=")) {
      g_triple = rt_after(a, "--target=");
    } else if (rt_starts_with(a, "-")) {
      rt_stderr("obasm: error: unknown option '" + a + "'\n");
      rt_exit(1);
    } else {
      if (g_in == "") { g_in = a; }
      g_ninputs = g_ninputs + 1;
    }
    i = i + 1;
  }
  return 0;
}

fn rt_arg(argv: string, i: i32) -> string { return ""; }
fn rt_starts_with(s: string, prefix: string) -> bool { return false; }
fn rt_after(s: string, sep: string) -> string { return ""; }
fn rt_itos(v: i32) -> string { return ""; }
fn rt_concat(a: string, b: string) -> string { return ""; }

// ===========================================================================
// Output naming (mirrors the strrchr() logic in obasm.c)
// ===========================================================================
fn default_output(input: string) -> string {
  return rt_strip_extension(input) + ".o";
}

fn bitcode_path(input: string) -> string {
  return input + ".bc";
}

// ===========================================================================
// assemble: pipeline mode
// ===========================================================================
fn assemble_pipeline(input: string, bitcode: string, output: string, triple: string) -> i32 {
  let rc: i32 = 0;
  if (g_verbose != 0) {
    rt_stderr("obasm: llvm-as " + input + " -> " + bitcode + "\n");
  }
  rc = rt_llvm_as(input, bitcode);
  if (rc != 0) {
    rt_stderr("obasm: error: failed to assemble '" + input + "' (llvm-as stage)\n");
  } else {
    if (g_verbose != 0) {
      if (triple != "") {
        rt_stderr("obasm: cc -c -mtriple=" + triple + " " + bitcode + " -> " + output + "\n");
      } else {
        rt_stderr("obasm: cc -c " + bitcode + " -> " + output + "\n");
      }
    }
    rc = rt_cc_object(bitcode, triple, output);
    if (rc != 0) {
      rt_stderr("obasm: error: failed to assemble '" + input + "' (object stage)\n");
    }
  }
  if (g_keep_bc == 0) {
    rt_file_remove(bitcode);
  }
  return rc;
}

fn rt_file_remove(path: string) -> i32 { return 0; }

// ===========================================================================
// assemble: direct mode (pure Wall ELF object writer)
// ===========================================================================
fn assemble_direct(input: string, output: string, triple: string) -> i32 {
  let asm: string = rt_file_read(input);
  if (asm == "") {
    rt_stderr("obasm: error: cannot read '" + input + "'\n");
    return 1;
  }
  let rc: i32 = rt_elf_begin(output, triple);
  if (rc == 0) {
    rc = rt_elf_add_text(asm);
  }
  if (rc == 0) {
    rc = rt_elf_finish();
  }
  if (rc != 0) {
    rt_stderr("obasm: error: direct ELF emission failed for '" + input + "'\n");
  }
  return rc;
}

// ===========================================================================
// main
// ===========================================================================
fn main(argc: i32, argv: string) -> i32 {
  parse_args(argc, argv);
  if (g_in == "") {
    rt_stderr("obasm: error: no input file\n");
    print_help();
    return 1;
  }
  if (!rt_file_exists(g_in)) {
    rt_stderr("obasm: error: cannot open '" + g_in + "'\n");
    return 1;
  }
  if (g_out == "") {
    g_out = default_output(g_in);
  }
  if (g_direct != 0) {
    return assemble_direct(g_in, g_out, g_triple);
  }
  return assemble_pipeline(g_in, bitcode_path(g_in), g_out, g_triple);
}

// ===========================================================================
// WALL_OBASM_REFERENCE_BEGIN
// Reference tables for the self-hosted object assembler.
//
// obasm accepts LLVM textual assembly (the `wall` compiler's .s output) and
// writes a native ELF relocatable object.  The tables below describe the
// instruction encodings, registers and directives the assembler understands.
// ===========================================================================

// ---- assembler directives --------------------------------------------------
fn dir_text() -> string { return ".text"; }
fn dir_data() -> string { return ".data"; }
fn dir_bss() -> string { return ".bss"; }
fn dir_rodata() -> string { return ".rodata"; }
fn dir_globl() -> string { return ".globl"; }
fn dir_global() -> string { return ".global"; }
fn dir_type() -> string { return ".type"; }
fn dir_size() -> string { return ".size"; }
fn dir_align() -> string { return ".align"; }
fn dir_p2align() -> string { return ".p2align"; }
fn dir_byte() -> string { return ".byte"; }
fn dir_short() -> string { return ".short"; }
fn dir_word() -> string { return ".word"; }
fn dir_quad() -> string { return ".quad"; }
fn dir_ascii() -> string { return ".ascii"; }
fn dir_asciz() -> string { return ".asciz"; }
fn dir_string() -> string { return ".string"; }
fn dir_section() -> string { return ".section"; }
fn dir_file() -> string { return ".file"; }
fn dir_loc() -> string { return ".loc"; }
fn dir_cfi_startproc() -> string { return ".cfi_startproc"; }
fn dir_cfi_endproc() -> string { return ".cfi_endproc"; }

