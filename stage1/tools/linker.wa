// stage1/tools/linker.wa
// ---------------------------------------------------------------------------
// linker - the Wall linker, written in Wall itself.
//
// Takes any set of relocatable object files (.o) and produces either:
//
//   * a shared object (.so)        with -shared
//   * a position independent ELF   with -pie
//   * a static executable           with -static
//   * a plain ELF executable       by default
//   * a merged relocatable object   with -r
//
// Usage:
//   linker <input.o...> [-o <output>] [-shared|-static|-pie|-r]
//                      [-L <dir>]... [-l <lib>]... [--target=<triple>]
//                      [-e <symbol>] [--direct] [-v] [-h] [-V]
//
// Two back ends are provided:
//
//   * pipeline mode (default): the linker drives the native toolchain
//     through rt_cc_link(), exactly like stage0's clang-based link step.
//
//   * direct mode (--direct): linker.wa reads the ELF relocatable objects,
//     resolves their symbols and writes the final .so or ELF image itself via
//     the rt_elf_* primitives.  This is the path that makes the Wall toolchain
//     independent of an external linker.
//
// Wall -> C mapping
// -----------------
// The C link step used by obasm/build.sh is `clang <objs> -o <out>`; this file
// expresses that step as data (flags) plus a small driver so the Wall
// self-hosted toolchain can perform it too.
// ---------------------------------------------------------------------------

// ===========================================================================
// Wall runtime hooks
// ===========================================================================
fn rt_exit(code: i32) -> i32 { return 0; }
fn rt_stdout(s: string) -> i32 { return 0; }
fn rt_stderr(s: string) -> i32 { return 0; }
fn rt_exec(argv: string) -> i32 { return 0; }
fn rt_file_exists(path: string) -> bool { return false; }
fn rt_file_remove(path: string) -> i32 { return 0; }
fn rt_read_elf_header(path: string) -> string { return ""; }
fn rt_read_elf_symbols(path: string) -> string { return ""; }
fn rt_read_elf_relocs(path: string) -> string { return ""; }
fn rt_write_so_image(out: string, data: string) -> i32 { return 0; }
fn rt_write_exec_image(out: string, data: string) -> i32 { return 0; }

// Toolchain pipeline hook: cc <inputs> <flags> -o <out>
fn rt_cc_link(inputs: string, out: string, mode: string, triple: string,
              libdirs: string, libs: string, entry: string) -> i32 { return 0; }

// Direct linker hooks
fn rt_ld_begin(out: string, mode: string, triple: string, entry: string) -> i32 { return 0; }
fn rt_ld_add_object(path: string) -> i32 { return 0; }
fn rt_ld_resolve() -> i32 { return 0; }
fn rt_ld_relocate() -> i32 { return 0; }
fn rt_ld_finish() -> i32 { return 0; }

// Small helpers
fn rt_itos(v: i32) -> string { return ""; }
fn rt_starts_with(s: string, prefix: string) -> bool { return false; }
fn rt_after(s: string, sep: string) -> string { return ""; }
fn rt_split(s: string, sep: string) -> string { return ""; }
fn rt_join(list: string, sep: string) -> string { return ""; }
fn rt_append(list: string, item: string, sep: string) -> string { return ""; }
fn rt_arg(argv: string, i: i32) -> string { return ""; }
fn rt_count(list: string, sep: string) -> i32 { return 0; }

// ===========================================================================
// Link modes
// ===========================================================================
global LD_EXE: string = "exe";
global LD_SHARED: string = "shared";
global LD_PIE: string = "pie";
global LD_STATIC: string = "static";
global LD_RELOC: string = "reloc";

// ===========================================================================
// Options
// ===========================================================================
global g_out: string = "a.out";
global g_mode: string = "exe";
global g_triple: string = "";
global g_entry: string = "";
global g_inputs: string = "";
global g_libdirs: string = "";
global g_libs: string = "";
global g_direct: i32 = 0;
global g_verbose: i32 = 0;
global g_ninputs: i32 = 0;
global g_nodelete: i32 = 0;

fn print_help() -> i32 {
  rt_stdout("wallc version 1.0.0\n");
  rt_stdout("Usage: linker <input.o...> [-o <output>] [options]\n");
  rt_stdout("\n");
  rt_stdout("Links relocatable objects into a shared object or an ELF binary.\n");
  rt_stdout("\n");
  rt_stdout("Output modes:\n");
  rt_stdout("  (default)            Produce an ELF executable\n");
  rt_stdout("  -shared              Produce a shared object (.so)\n");
  rt_stdout("  -pie                 Produce a position independent executable\n");
  rt_stdout("  -static              Produce a static executable\n");
  rt_stdout("  -r, --relocatable    Merge objects into one relocatable object\n");
  rt_stdout("\n");
  rt_stdout("Options:\n");
  rt_stdout("  -o <filename>        Set output filename (default: a.out)\n");
  rt_stdout("  -L <dir>             Add a library search directory\n");
  rt_stdout("  -l <lib>             Link against library <lib>\n");
  rt_stdout("  -e, --entry <sym>    Set the entry symbol\n");
  rt_stdout("  --target=<triple>    Set the target triple\n");
  rt_stdout("  --direct             Link to ELF directly (no external tools)\n");
  rt_stdout("  -v, --verbose        Print each pipeline step\n");
  rt_stdout("  -V, --version        Print version information and exit\n");
  rt_stdout("  -h, --help           Print this help message and exit\n");
  return 0;
}

fn print_version() -> i32 {
  rt_stdout("wallc version 1.0.0\n");
  return 0;
}

// ===========================================================================
// Argument parsing
// ===========================================================================
fn parse_args(argc: i32, argv: string) -> i32 {
  let i: i32 = 1;
  while (i < argc) {
    let a: string = rt_arg(argv, i);
    if (a == "-h" || a == "--help") {
      print_help();
      rt_exit(0);
    } else if (a == "-V" || a == "--version") {
      print_version();
      rt_exit(0);
    } else if (a == "-o") {
      if (i + 1 < argc) {
        i = i + 1;
        g_out = rt_arg(argv, i);
      } else {
        rt_stderr("linker: error: -o requires a filename\n");
        rt_exit(1);
      }
    } else if (a == "-shared") {
      g_mode = LD_SHARED;
      if (rt_ends_with(g_out, "a.out")) { g_out = "libwall_out.so"; }
    } else if (a == "-pie") {
      g_mode = LD_PIE;
    } else if (a == "-static") {
      g_mode = LD_STATIC;
    } else if (a == "-r" || a == "--relocatable") {
      g_mode = LD_RELOC;
    } else if (a == "-e" || a == "--entry") {
      if (i + 1 < argc) {
        i = i + 1;
        g_entry = rt_arg(argv, i);
      } else {
        rt_stderr("linker: error: -e requires a symbol\n");
        rt_exit(1);
      }
    } else if (a == "-L") {
      if (i + 1 < argc) {
        i = i + 1;
        g_libdirs = rt_append(g_libdirs, rt_arg(argv, i), "\x1e");
      } else {
        rt_stderr("linker: error: -L requires a directory\n");
        rt_exit(1);
      }
    } else if (a == "-l") {
      if (i + 1 < argc) {
        i = i + 1;
        g_libs = rt_append(g_libs, rt_arg(argv, i), "\x1e");
      } else {
        rt_stderr("linker: error: -l requires a library name\n");
        rt_exit(1);
      }
    } else if (a == "--direct") {
      g_direct = 1;
    } else if (a == "-v" || a == "--verbose") {
      g_verbose = 1;
    } else if (rt_starts_with(a, "--target=")) {
      g_triple = rt_after(a, "--target=");
    } else if (rt_starts_with(a, "-")) {
      rt_stderr("linker: error: unknown option '" + a + "'\n");
      rt_exit(1);
    } else {
      g_inputs = rt_append(g_inputs, a, "\x1e");
      g_ninputs = g_ninputs + 1;
    }
    i = i + 1;
  }
  return 0;
}

fn rt_ends_with(s: string, suffix: string) -> bool { return false; }

// ===========================================================================
// Validation
// ===========================================================================
fn validate() -> bool {
  let ok: bool = true;
  if (g_ninputs == 0) {
    rt_stderr("linker: error: no input files\n");
    ok = false;
  } else {
    let n: i32 = rt_count(g_inputs, "\x1e");
    let i: i32 = 0;
    while (i < n) {
      let obj: string = rt_nth(g_inputs, "\x1e", i);
      if (!rt_file_exists(obj)) {
        rt_stderr("linker: error: cannot open '" + obj + "'\n");
        ok = false;
      }
      i = i + 1;
    }
  }
  return ok;
}

fn rt_nth(list: string, sep: string, idx: i32) -> string { return ""; }

// ===========================================================================
// pipeline mode
// ===========================================================================
fn link_pipeline() -> i32 {
  let mode: string = g_mode;
  if (g_verbose != 0) {
    rt_stderr("linker: mode=" + mode + " output=" + g_out + "\n");
    let n: i32 = rt_count(g_inputs, "\x1e");
    let i: i32 = 0;
    while (i < n) {
      rt_stderr("linker: input " + rt_nth(g_inputs, "\x1e", i) + "\n");
      i = i + 1;
    }
  }
  return rt_cc_link(g_inputs, g_out, mode, g_triple, g_libdirs, g_libs, g_entry);
}

// ===========================================================================
// direct mode: resolve and relocate ELF objects ourselves
// ===========================================================================
fn link_direct() -> i32 {
  let rc: i32 = rt_ld_begin(g_out, g_mode, g_triple, g_entry);
  if (rc == 0) {
    let n: i32 = rt_count(g_inputs, "\x1e");
    let i: i32 = 0;
    while (i < n) {
      let obj: string = rt_nth(g_inputs, "\x1e", i);
      if (g_verbose != 0) {
        rt_stderr("linker: loading " + obj + "\n");
      }
      rc = rt_ld_add_object(obj);
      if (rc != 0) {
        i = n;
      } else {
        i = i + 1;
      }
    }
  }
  if (rc == 0) {
    rc = rt_ld_resolve();
  }
  if (rc == 0) {
    rc = rt_ld_relocate();
  }
  if (rc == 0) {
    rc = rt_ld_finish();
  }
  if (rc != 0) {
    rt_stderr("linker: error: direct link failed\n");
  }
  return rc;
}

// ===========================================================================
// main
// ===========================================================================
fn main(argc: i32, argv: string) -> i32 {
  parse_args(argc, argv);
  if (!validate()) {
    return 1;
  }
  if (g_direct != 0) {
    return link_direct();
  }
  return link_pipeline();
}

// ===========================================================================
// WALL_LINKER_REFERENCE_BEGIN
// Reference tables for the self-hosted linker.
//
// The linker consumes ELF relocatable objects and produces either a shared
// object (ET_DYN) or an executable (ET_EXEC / ET_DYN for PIE).  The tables
// below name the ELF constants used by the writer.  Values follow the System
// V gABI and the per-architecture supplements.
// ===========================================================================

// ---- ELF identification -----------------------------------------------------
global EI_MAG0: i32 = 0;
global EI_MAG1: i32 = 1;
global EI_MAG2: i32 = 2;
global EI_MAG3: i32 = 3;
global EI_CLASS: i32 = 4;
global EI_DATA: i32 = 5;
global EI_VERSION: i32 = 6;
global EI_OSABI: i32 = 7;
global EI_ABIVERSION: i32 = 8;
global EI_PAD: i32 = 9;
global EI_NIDENT: i32 = 16;

global ELFCLASS32: i32 = 1;
global ELFCLASS64: i32 = 2;
global ELFDATA2LSB: i32 = 1;
global ELFDATA2MSB: i32 = 2;
global EV_CURRENT: i32 = 1;
global ELFOSABI_SYSV: i32 = 0;
global ELFOSABI_LINUX: i32 = 3;

// ---- e_type ----------------------------------------------------------------
global ET_NONE: i32 = 0;
global ET_REL: i32 = 1;
global ET_EXEC: i32 = 2;
global ET_DYN: i32 = 3;
global ET_CORE: i32 = 4;

// ---- e_machine -------------------------------------------------------------
