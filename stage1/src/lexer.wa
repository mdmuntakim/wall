// stage1/src/lexer.wa
// ---------------------------------------------------------------------------
// Wall self-hosted lexer.
//
// This file is a direct transformation of the C functions in
// src/compiler/libwall.c:
//
//     lex()               -> lex()
//     tok_push()          -> tok_push()
//     character classes   -> is_alpha_c() / is_digit_c() / ...
//
// C -> Wall mapping
// -----------------
//   * The C `Lexer` struct becomes a set of module globals (g_lex_src,
//     g_lex_pos, g_lex_line, g_lex_col, g_lex_had_err, g_lex_err).
//   * The C `Token` struct becomes six parallel token tables.  The Wall
//     runtime exposes growable tables through the rt_tok_* hooks declared
//     below, mirroring the realloc() driven tok_push() in C.
//   * `continue` does not exist in the current Wall grammar, so every loop
//     body is written as a flat if/else chain.
//   * The C `Buf` (growable byte buffer) maps onto a Wall `string`, which is
//     already growable and concatenates with `+`.
//
// Token encoding
// --------------
// Tokens are also exposed to the rest of the compiler as a flat string:
//
//     type \x1f line \x1f col \x1f text \x1f num \x1f slen \x1e
//
// This keeps the lexer/parser interface expressible without structs while
// remaining a lossless representation of the C Token type.
// ---------------------------------------------------------------------------

// ===========================================================================
// Runtime hooks
// ===========================================================================
// These are provided by the Wall runtime (libwall.so).  During bootstrap they
// are lowered to the equivalent libc calls used by stage0.
fn rt_len(s: string) -> i32 { return 0; }
fn rt_char(s: string, i: i32) -> string { return ""; }
fn rt_sub(s: string, start: i32, len: i32) -> string { return ""; }
fn rt_ord(c: string) -> i32 { return 0; }
fn rt_chr(n: i32) -> string { return ""; }
fn rt_parse_int(s: string) -> i64 { return 0; }
fn rt_tok_reset() -> i32 { return 0; }
fn rt_tok_push(ttype: i32, line: i32, col: i32, text: string, num: i64, slen: i32) -> i32 { return 0; }
fn rt_tok_count() -> i32 { return 0; }
fn rt_tok_type(i: i32) -> i32 { return 0; }
fn rt_tok_line(i: i32) -> i32 { return 0; }
fn rt_tok_col(i: i32) -> i32 { return 0; }
fn rt_tok_text(i: i32) -> string { return ""; }
fn rt_tok_num(i: i32) -> i64 { return 0; }
fn rt_tok_slen(i: i32) -> i32 { return 0; }

// ===========================================================================
// Token kinds (mirrors the C enum in libwall.c)
// ===========================================================================
global TK_EOF: i32 = 0;
global TK_IDENT: i32 = 1;
global TK_INT: i32 = 2;
global TK_STRING: i32 = 3;
global TK_PUNCT: i32 = 4;
global TK_ERROR: i32 = 255;

// ===========================================================================
// Lexer state (mirrors `typedef struct { ... } Lexer`)
// ===========================================================================
global g_lex_src: string = "";
global g_lex_pos: i32 = 0;
global g_lex_line: i32 = 1;
global g_lex_col: i32 = 1;
global g_lex_had_err: i32 = 0;
global g_lex_err: string = "";
global g_lex_n: i32 = 0;

fn lexer_reset(src: string) -> i32 {
  g_lex_src = src;
  g_lex_pos = 0;
  g_lex_line = 1;
  g_lex_col = 1;
  g_lex_had_err = 0;
  g_lex_err = "";
  g_lex_n = 0;
  rt_tok_reset();
  return 0;
}

fn lexer_error(line: i32, col: i32, ch: string) -> i32 {
  g_lex_had_err = 1;
  g_lex_err = int_str(line) + ":" + int_str(col) + ": error: unexpected character '" + ch + "'";
  return 0;
}

// ===========================================================================
// Character classes (mirror isalpha()/isdigit()/isalnum()/isxdigit() and the
// punctuation test in lex()).
// ===========================================================================
fn is_alpha_c(c: string) -> bool {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_";
}

fn is_digit_c(c: string) -> bool {
  return c >= "0" && c <= "9";
}

fn is_alnum_c(c: string) -> bool {
  return is_alpha_c(c) || is_digit_c(c);
}

fn is_hex_c(c: string) -> bool {
  return is_digit_c(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F");
}

fn is_space_c(c: string) -> bool {
  return c == " " || c == "\t" || c == "\n" || c == "\r";
}

fn is_punct_c(c: string) -> bool {
  if (c == "+") { return true; }
  if (c == "-") { return true; }
  if (c == "*") { return true; }
  if (c == "/") { return true; }
  if (c == "<") { return true; }
  if (c == ">") { return true; }
  if (c == "=") { return true; }
  if (c == "!") { return true; }
  if (c == "&") { return true; }
  if (c == "|") { return true; }
  if (c == "^") { return true; }
  if (c == "%") { return true; }
  if (c == "~") { return true; }
  if (c == "?") { return true; }
  if (c == ":") { return true; }
  if (c == ",") { return true; }
  if (c == "(") { return true; }
  if (c == ")") { return true; }
  if (c == "{") { return true; }
  if (c == "}") { return true; }
  if (c == "[") { return true; }
  if (c == "]") { return true; }
  if (c == ";") { return true; }
  return false;
}

// two_char_punct: the C lexer matches a fixed set of two-byte operators before
// single-byte punctuation.  Returns "" when c1c2 is not a two-char operator.
fn two_char_punct(c1: string, c2: string) -> string {
  if (c1 == "-" && c2 == ">") { return "->"; }
  if (c1 == "&" && c2 == "&") { return "&&"; }
  if (c1 == "|" && c2 == "|") { return "||"; }
  if (c1 == "=" && c2 == "=") { return "=="; }
  if (c1 == "!" && c2 == "=") { return "!="; }
  if (c1 == "<" && c2 == "=") { return "<="; }
  if (c1 == ">" && c2 == "=") { return ">="; }
  if (c1 == ">" && c2 == ">") { return ">>"; }
  if (c1 == "<" && c2 == "<") { return "<<"; }
  return "";
}

// ===========================================================================
// Token push (mirrors tok_push()).
// ===========================================================================
fn tok_push(ttype: i32, line: i32, col: i32, text: string, num: i64, slen: i32) -> i32 {
  rt_tok_push(ttype, line, col, text, num, slen);
  g_lex_n = g_lex_n + 1;
  return 0;
}

// ===========================================================================
// Escape decoding for string literals (mirrors the escape switch in lex()).
// ===========================================================================
fn decode_escape(e: string) -> string {
  if (e == "n") { return "\n"; }
  if (e == "t") { return "\t"; }
  if (e == "r") { return "\r"; }
  if (e == "0") { return "\x00"; }
  if (e == "\\") { return "\\"; }
  if (e == "\"") { return "\""; }
  if (e == "'") { return "'"; }
  return e;
}

fn hex_value(s: string) -> i32 {
  if (s >= "0" && s <= "9") { return rt_ord(s) - rt_ord("0"); }
  if (s >= "a" && s <= "f") { return rt_ord(s) - rt_ord("a") + 10; }
  if (s >= "A" && s <= "F") { return rt_ord(s) - rt_ord("A") + 10; }
  return 0;
}

// ===========================================================================
// lex: the main tokenisation loop (direct transformation of lex()).
// ===========================================================================
fn lex() -> i32 {
  let done: bool = false;
  while (!done) {
    let c: string = rt_char(g_lex_src, g_lex_pos);
    if (c == "") {
      tok_push(TK_EOF, g_lex_line, g_lex_col, "", 0, 0);
      done = true;
    } else {
      if (is_space_c(c)) {
        if (c == "\n") {
          g_lex_line = g_lex_line + 1;
          g_lex_col = 1;
        } else {
          g_lex_col = g_lex_col + 1;
        }
        g_lex_pos = g_lex_pos + 1;
      } else {
        if (is_alpha_c(c)) {
          let start: i32 = g_lex_pos;
          let scanning: bool = true;
          while (scanning) {
            let cc: string = rt_char(g_lex_src, g_lex_pos);
            if (is_alnum_c(cc)) {
              g_lex_pos = g_lex_pos + 1;
              g_lex_col = g_lex_col + 1;
            } else {
              scanning = false;
            }
          }
          tok_push(TK_IDENT, g_lex_line, g_lex_col, rt_sub(g_lex_src, start, g_lex_pos - start), 0, 0);
        } else {
          if (is_digit_c(c)) {
            let start: i32 = g_lex_pos;
            let scanning: bool = true;
            while (scanning) {
              let cc: string = rt_char(g_lex_src, g_lex_pos);
              if (is_digit_c(cc)) {
                g_lex_pos = g_lex_pos + 1;
                g_lex_col = g_lex_col + 1;
              } else {
                scanning = false;
              }
            }
            let txt: string = rt_sub(g_lex_src, start, g_lex_pos - start);
            tok_push(TK_INT, g_lex_line, g_lex_col, txt, rt_parse_int(txt), 0);
          } else {
            if (c == "\"") {
              g_lex_pos = g_lex_pos + 1;
              g_lex_col = g_lex_col + 1;
              let lit: string = "";
              let scanning: bool = true;
              while (scanning) {
                let cc: string = rt_char(g_lex_src, g_lex_pos);
                if (cc == "" || cc == "\"") {
                  scanning = false;
                } else {
                  if (cc == "\\") {
                    let e: string = rt_char(g_lex_src, g_lex_pos + 1);
                    if (e == "x") {
                      let h1: string = rt_char(g_lex_src, g_lex_pos + 2);
                      let h2: string = rt_char(g_lex_src, g_lex_pos + 3);
                      if (is_hex_c(h1) && is_hex_c(h2)) {
                        lit = lit + rt_chr(hex_value(h1) * 16 + hex_value(h2));
                        g_lex_pos = g_lex_pos + 4;
                        g_lex_col = g_lex_col + 4;
                      } else {
                        scanning = false;
                      }
                    } else {
                      lit = lit + decode_escape(e);
                      g_lex_pos = g_lex_pos + 2;
                      g_lex_col = g_lex_col + 2;
                    }
                  } else {
                    lit = lit + cc;
                    g_lex_pos = g_lex_pos + 1;
                    g_lex_col = g_lex_col + 1;
                  }
                }
              }
              if (rt_char(g_lex_src, g_lex_pos) == "\"") {
                g_lex_pos = g_lex_pos + 1;
                g_lex_col = g_lex_col + 1;
              }
              tok_push(TK_STRING, g_lex_line, g_lex_col, lit, 0, rt_len(lit));
            } else {
              let c2: string = rt_char(g_lex_src, g_lex_pos + 1);
              let two: string = two_char_punct(c, c2);
              if (two != "") {
                tok_push(TK_PUNCT, g_lex_line, g_lex_col, two, 0, 0);
                g_lex_pos = g_lex_pos + 2;
                g_lex_col = g_lex_col + 2;
              } else {
                if (is_punct_c(c)) {
                  tok_push(TK_PUNCT, g_lex_line, g_lex_col, c, 0, 0);
                  g_lex_pos = g_lex_pos + 1;
                  g_lex_col = g_lex_col + 1;
                } else {
                  lexer_error(g_lex_line, g_lex_col, c);
                  done = true;
                }
              }
            }
          }
        }
      }
    }
  }
  return 0;
}

// ===========================================================================
// lex_all: lexer entry point used by the backend.
// Returns the flat token stream described at the top of this file.
// ===========================================================================
fn lex_all(source: string) -> string {
  lexer_reset(source);
  lex();
  let out: string = "";
  let i: i32 = 0;
  let n: i32 = rt_tok_count();
  while (i < n) {
    out = out + int_str(rt_tok_type(i));
    out = out + "\x1f";
    out = out + int_str(rt_tok_line(i));
    out = out + "\x1f";
    out = out + int_str(rt_tok_col(i));
    out = out + "\x1f";
    out = out + rt_tok_text(i);
    out = out + "\x1f";
    out = out + i64_str(rt_tok_num(i));
    out = out + "\x1f";
    out = out + int_str(rt_tok_slen(i));
    out = out + "\x1e";
    i = i + 1;
  }
  return out;
}

// ===========================================================================
// Small integer formatting helpers (the Wall runtime also provides these; the
// local definitions keep the compiler bootstrappable without libc).
// ===========================================================================
fn int_str(v: i32) -> string {
  return rt_int_to_string(v);
}

fn i64_str(v: i64) -> string {
  return rt_i64_to_string(v);
}

fn rt_int_to_string(v: i32) -> string { return ""; }
fn rt_i64_to_string(v: i64) -> string { return ""; }
