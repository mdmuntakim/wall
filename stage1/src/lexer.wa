// Stage1 - Wall lexer (written in Wall itself)
// Tokenizes a Wall source string into a token string.

fn is_digit(c: string) -> bool {
    return c >= "0" && c <= "9";
}

fn is_alpha(c: string) -> bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_";
}

fn is_punct_char(c: string) -> bool {
    return (c == "+" || c == "-" || c == "*" || c == "/" || c == "<" || c == ">" ||
            c == "=" || c == "!" || c == "&" || c == "|" || c == "%" || c == "~" ||
            c == "?" || c == ":" || c == "," || c == "(" || c == ")" || c == "{" || c == "}" ||
            c == "[" || c == "]");
}

fn lex_all(source: string) -> string {
    let tokens: string = "";
    let i: i32 = 0;
    let n: i32 = 0;
    while (i < source_len(source)) {
        let c: string = source_char(source, i);
        if c == " " || c == "\n" || c == "\t" || c == "\r" {
            i = i + 1;
            continue;
        }
        if is_alpha(c) {
            let start: i32 = i;
            while (i < source_len(source)) {
                let cc: string = source_char(source, i);
                if is_alpha(cc) || is_digit(cc) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            tokens = tokens + "1 ";
            tokens = tokens + source_substr(source, start, i - start);
            tokens = tokens + " ";
            n = n + 1;
            continue;
        }
        if is_digit(c) {
            let start: i32 = i;
            while (i < source_len(source)) {
                let cc: string = source_char(source, i);
                if is_digit(cc) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            tokens = tokens + "2 ";
            tokens = tokens + source_substr(source, start, i - start);
            tokens = tokens + " ";
            n = n + 1;
            continue;
        }
        if c == "\"" {
            let start: i32 = i;
            i = i + 1;
            while (i < source_len(source)) {
                let cc: string = source_char(source, i);
                if cc == "\"" {
                    i = i + 1;
                    break;
                }
                i = i + 1;
            }
            tokens = tokens + "3 ";
            tokens = tokens + source_substr(source, start + 1, i - start - 2);
            tokens = tokens + " ";
            n = n + 1;
            continue;
        }
        if is_punct_char(c) {
            tokens = tokens + "4 ";
            tokens = tokens + c;
            tokens = tokens + " ";
            n = n + 1;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    return tokens;
}
