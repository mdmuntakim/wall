// wallrt.wa - Wall freestanding runtime, written in Wall.
//
// Sits on top of the raw system-call wrappers in stage1/runtime/syscall.s
// (the only assembly in the implementation path).  Provides:
//   - bump allocator over brk
//   - memory / string primitives
//   - growable byte buffers
//   - decimal / hex formatting and printing (fixed arity, no varargs)
//   - SHA-256 (used for the deterministic .comment content stamp)
//
// Every tool (objc, and later the self-hosted linker and compiler) includes
// this file textually; it defines no main().

extern fn rt_exit(code: i32) -> void;
extern fn rt_write(fd: i64, buf: *u8, n: i64) -> i64;
extern fn rt_read(fd: i64, buf: *u8, n: i64) -> i64;
extern fn rt_close(fd: i64) -> i64;
extern fn rt_open(path: *u8, flags: i64, mode: i64) -> i64;
extern fn rt_brk(addr: *u8) -> *u8;

// ---------------------------------------------------------------- alloc
global rt_heap: i64 = 0;

fn rt_alloc(n: i64) -> *u8 {
  if (rt_heap == 0) {
    rt_heap = rt_brk(0 as *u8) as i64;
  }
  // 16-byte align the allocation
  let p: i64 = (rt_heap + 15) & -16;
  let next: i64 = p + n + 16;
  let got: i64 = rt_brk(next as *u8) as i64;
  if (got < next) {
    rt_write(2, "objc: out of memory\n", 20);
    rt_exit(1);
  }
  rt_heap = next;
  return p as *u8;
}

fn rt_zero(p: *u8, n: i64) -> void {
  let i: i64 = 0;
  while (i < n) {
    p[i] = 0;
    i += 1;
  }
}

fn rt_copy(d: *u8, s: *u8, n: i64) -> void {
  let i: i64 = 0;
  while (i < n) {
    d[i] = s[i];
    i += 1;
  }
}

// ---------------------------------------------------------------- strings
fn rt_strlen(s: *u8) -> i64 {
  let n: i64 = 0;
  while (s[n] != 0) {
    n += 1;
  }
  return n;
}

fn rt_streq(a: *u8, b: *u8) -> bool {
  let i: i64 = 0;
  while (a[i] != 0 && b[i] != 0) {
    if (a[i] != b[i]) { return false; }
    i += 1;
  }
  return a[i] == b[i];
}

fn rt_strcpy(d: *u8, s: *u8) -> void {
  let i: i64 = 0;
  while (s[i] != 0) {
    d[i] = s[i];
    i += 1;
  }
  d[i] = 0;
}

fn rt_strdup(s: *u8) -> *u8 {
  let n: i64 = rt_strlen(s);
  let d: *u8 = rt_alloc(n + 1);
  rt_copy(d, s, n);
  d[n] = 0;
  return d;
}

// ---------------------------------------------------------------- buffers
struct Buf {
  data: *u8,
  len: i64,
  cap: i64
}

fn buf_init(b: *Buf) -> void {
  b.data = rt_alloc(256);
  b.len = 0;
  b.cap = 256;
}

fn buf_grow(b: *Buf, need: i64) -> void {
  if (b.len + need <= b.cap) { return; }
  let nc: i64 = b.cap * 2;
  while (nc < b.len + need + 64) {
    nc *= 2;
  }
  let nd: *u8 = rt_alloc(nc);
  rt_copy(nd, b.data, b.len);
  rt_zero(nd + b.len, nc - b.len);
  b.data = nd;
  b.cap = nc;
}

fn buf_putb(b: *Buf, c: u8) -> void {
  buf_grow(b, 1);
  b.data[b.len] = c;
  b.len += 1;
}

fn buf_append(b: *Buf, p: *u8, n: i64) -> void {
  buf_grow(b, n);
  rt_copy(b.data + b.len, p, n);
  b.len += n;
}

fn buf_puts(b: *Buf, s: *u8) -> void {
  buf_append(b, s, rt_strlen(s));
}

// ---------------------------------------------------------------- output
fn print(s: *u8) -> i64 {
  return rt_write(1, s, rt_strlen(s));
}

fn print_err(s: *u8) -> i64 {
  return rt_write(2, s, rt_strlen(s));
}

fn u64_to_dec(v: u64, out: *u8) -> i64 {
  let tmp: [24]u8;
  let i: i32 = 0;
  let u: u64 = v;
  if (u == 0) {
    out[0] = '0';
    return 1;
  }
  while (u > 0) {
    tmp[i] = (u % 10) as u8 + '0';
    u = u / 10;
    i += 1;
  }
  let n: i32 = i;
  let j: i32 = 0;
  while (j < n) {
    out[j] = tmp[n - 1 - j];
    j += 1;
  }
  return n as i64;
}

fn print_i64(v: i64) -> i64 {
  let tmp: [32]u8;
  let n: i64 = 0;
  let u: u64 = v as u64;
  if (v < 0) {
    tmp[0] = '-';
    n = 1 + u64_to_dec((0 - v) as u64, tmp + 1);
  } else {
    n = u64_to_dec(u, tmp);
  }
  return rt_write(1, tmp, n);
}

fn u64_to_hex(v: u64, out: *u8, width: i32) -> i64 {
  let digits: *u8 = "0123456789abcdef";
  let i: i32 = 0;
  while (i < width) {
    out[i] = digits[((v >> ((width - 1 - i) * 4)) & 15) as i64] ;
    i += 1;
  }
  return width as i64;
}

fn print_hex64(v: u64) -> i64 {
  let tmp: [20]u8;
  tmp[0] = '0';
  tmp[1] = 'x';
  u64_to_hex(v, tmp + 2, 16);
  return rt_write(1, tmp, 18);
}

fn die_msg(msg: *u8) -> void {
  print_err(msg);
  rt_exit(1);
}

// ---------------------------------------------------------------- file io
// O_RDONLY = 0, O_WRONLY = 1, O_RDWR = 2, O_CREAT = 64, O_TRUNC = 512
fn rt_read_file(path: *u8, outlen: *i64) -> *u8 {
  let fd: i64 = rt_open(path, 0, 0);
  if (fd < 0) {
    return 0 as *u8;
  }
  let cap: i64 = 65536;
  let b: Buf;
  buf_init(&b);
  let chunk: *u8 = rt_alloc(65536);
  for (;;) {
    let n: i64 = rt_read(fd, chunk, 65536);
    if (n <= 0) { break; }
    buf_append(&b, chunk, n);
  }
  rt_close(fd);
  outlen[0] = b.len;
  return b.data;
}

fn rt_write_file(path: *u8, data: *u8, n: i64) -> i64 {
  // 0x41 = O_WRONLY|O_CREAT, 0644 mode
  let fd: i64 = rt_open(path, 577, 420);
  if (fd < 0) {
    return -1;
  }
  let done: i64 = 0;
  while (done < n) {
    let w: i64 = rt_write(fd, data + done, n - done);
    if (w <= 0) {
      rt_close(fd);
      return -1;
    }
    done += w;
  }
  rt_close(fd);
  return n;
}

// ---------------------------------------------------------------- sha256
struct Sha {
  h0: u32, h1: u32, h2: u32, h3: u32,
  h4: u32, h5: u32, h6: u32, h7: u32,
  len: u64
}

fn sha_k(i: i32) -> u32 {
  // first 64 primes' cube-root fractional parts
  if (i < 16) {
    if (i == 0) { return 1116352408; }
    if (i == 1) { return 1899447441; }
    if (i == 2) { return 3049323471; }
    if (i == 3) { return 3921009573; }
    if (i == 4) { return 961987163; }
    if (i == 5) { return 1508970993; }
    if (i == 6) { return 2453635748; }
    if (i == 7) { return 2870763221; }
    if (i == 8) { return 3624381080; }
    if (i == 9) { return 310598401; }
    if (i == 10) { return 607225278; }
    if (i == 11) { return 1426881987; }
    if (i == 12) { return 1925078388; }
    if (i == 13) { return 2162078206; }
    if (i == 14) { return 2614888103; }
    return 3248222580;
  }
  if (i < 32) {
    if (i == 16) { return 3835390401; }
    if (i == 17) { return 4022224774; }
    if (i == 18) { return 264347078; }
    if (i == 19) { return 604807628; }
    if (i == 20) { return 770255983; }
    if (i == 21) { return 1249150122; }
    if (i == 22) { return 1555081692; }
    if (i == 23) { return 1996064986; }
    if (i == 24) { return 2554220882; }
    if (i == 25) { return 2821834349; }
    if (i == 26) { return 2952996808; }
    if (i == 27) { return 3210313671; }
    if (i == 28) { return 3336571891; }
    if (i == 29) { return 3584528711; }
    if (i == 30) { return 113926993; }
    return 338241895;
  }
  if (i < 48) {
    if (i == 32) { return 663601893; }
    if (i == 33) { return 2242463672; }
    if (i == 34) { return 3274292635; }
    if (i == 35) { return 373116470; }
    if (i == 36) { return 1211914535; }
    if (i == 37) { return 1591677339; }
    if (i == 38) { return 1804603682; }
    if (i == 39) { return 2007108623; }
    if (i == 40) { return 2268011598; }
    if (i == 41) { return 2456956037; }
    if (i == 42) { return 2730485921; }
    if (i == 43) { return 2820302411; }
    if (i == 44) { return 3259730800; }
    if (i == 45) { return 3345764771; }
    if (i == 46) { return 3516065817; }
    return 3600352804;
  }
  if (i == 48) { return 4094571909; }
  if (i == 49) { return 2754233437; }
  if (i == 50) { return 430227734; }
  if (i == 51) { return 506948616; }
  if (i == 52) { return 659060556; }
  if (i == 53) { return 883997877; }
  if (i == 54) { return 958139571; }
  if (i == 55) { return 1322822218; }
  if (i == 56) { return 1537002063; }
  if (i == 57) { return 1747873779; }
  if (i == 58) { return 1955562222; }
  if (i == 59) { return 2024104815; }
  if (i == 60) { return 2227730452; }
  if (i == 61) { return 2361852424; }
  if (i == 62) { return 2428436474; }
  if (i == 63) { return 2756734187; }
  return 0;
}

fn sha_rotr(v: u32, n: i32) -> u32 {
  return (v >> n) | (v << (32 - n));
}

fn sha_process(s: *Sha, block: *u8) -> void {
  let w: [64]u32;
  let i: i32 = 0;
  while (i < 16) {
    w[i] = (block[i * 4] as u32 << 24) | (block[i * 4 + 1] as u32 << 16)
         | (block[i * 4 + 2] as u32 << 8) | (block[i * 4 + 3] as u32);
    i += 1;
  }
  while (i < 64) {
    let s0: u32 = sha_rotr(w[i - 15], 7) ^ sha_rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
    let s1: u32 = sha_rotr(w[i - 2], 17) ^ sha_rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    i += 1;
  }
  let a: u32 = s.h0;
  let b: u32 = s.h1;
  let c: u32 = s.h2;
  let d: u32 = s.h3;
  let e: u32 = s.h4;
  let f: u32 = s.h5;
  let g: u32 = s.h6;
  let h: u32 = s.h7;
  i = 0;
  while (i < 64) {
    let S1: u32 = sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25);
    let ch: u32 = (e & f) ^ (~e & g);
    let t1: u32 = h + S1 + ch + sha_k(i) + w[i];
    let S0: u32 = sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22);
    let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
    let t2: u32 = S0 + maj;
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
    i += 1;
  }
  s.h0 = s.h0 + a;
  s.h1 = s.h1 + b;
  s.h2 = s.h2 + c;
  s.h3 = s.h3 + d;
  s.h4 = s.h4 + e;
  s.h5 = s.h5 + f;
  s.h6 = s.h6 + g;
  s.h7 = s.h7 + h;
  s.len = s.len + 64;
}

fn sha_init(s: *Sha) -> void {
  s.h0 = 1779033703;
  s.h1 = 3144134277;
  s.h2 = 1013904242;
  s.h3 = 2773480762;
  s.h4 = 1359893119;
  s.h5 = 2600822924;
  s.h6 = 528734635;
  s.h7 = 1541459225;
  s.len = 0;
}

// hash len bytes at p; writes 32 raw bytes to digest
fn sha_hash(p: *u8, n: i64, digest: *u8) -> void {
  let s: Sha;
  sha_init(&s);
  let done: i64 = 0;
  while (done + 64 <= n) {
    sha_process(&s, p + done);
    done += 64;
  }
  // tail with padding
  let tail: [128]u8;
  rt_zero(tail, 128);
  let rest: i64 = n - done;
  rt_copy(tail, p + done, rest);
  tail[rest] = 128;
  let bitlen: u64 = (s.len + rest as u64) * 8;
  let total: i64 = rest + 1;
  if (total > 56) { total = 120; } else { total = 56; }
  // write big-endian bit length at the end of the last padded block
  tail[total + 0] = (bitlen >> 56) as u8;
  tail[total + 1] = (bitlen >> 48) as u8;
  tail[total + 2] = (bitlen >> 40) as u8;
  tail[total + 3] = (bitlen >> 32) as u8;
  tail[total + 4] = (bitlen >> 24) as u8;
  tail[total + 5] = (bitlen >> 16) as u8;
  tail[total + 6] = (bitlen >> 8) as u8;
  tail[total + 7] = bitlen as u8;
  sha_process(&s, tail);
  if (total == 120) {
    sha_process(&s, tail + 64);   // length lives in the second block
  }
  let hs: [8]u32;
  hs[0] = s.h0;
  hs[1] = s.h1;
  hs[2] = s.h2;
  hs[3] = s.h3;
  hs[4] = s.h4;
  hs[5] = s.h5;
  hs[6] = s.h6;
  hs[7] = s.h7;
  let i: i32 = 0;
  while (i < 8) {
    digest[i * 4 + 0] = (hs[i] >> 24) as u8;
    digest[i * 4 + 1] = (hs[i] >> 16) as u8;
    digest[i * 4 + 2] = (hs[i] >> 8) as u8;
    digest[i * 4 + 3] = hs[i] as u8;
    i += 1;
  }
}
